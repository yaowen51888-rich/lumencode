  "enabledTools": [],
  "repos": [],
  "excludeProjects": [],
  "blockQuota": null,
  "costMode": "auto",
  "aiAttribution": {
    "windows": {
      "weakWindowMinutes": 30,
      "crossDayWindowDays": 3
    },
    "confidenceThresholds": {
      "high": 0.75,
      "medium": 0.45,
      "low": 0.20
    },
    "confidenceWeights": {
      "high": 1.0,
      "medium": 0.7,
      "low": 0.2,
      "none": 0
