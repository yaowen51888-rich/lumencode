    "documentation": ["文档", "readme.md", "注释", "说明", "指南", "guide", "wiki", "手册", "api doc"],
    "review": ["review", "审查", "代码审查", "/review", "pr", "pull request", "approve", "approval", "reject", "走查", "代码走查"],
    "planning": ["计划", "plan", "设计", "架构", "方案", "design", "architect", "roadmap", "规划"],
