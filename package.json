{
  "name": "lumencode",
  "version": "1.4.2",
  "description": "LumenCode — AI 编码助手使用分析与周报工具：15 工具统一、行级 AI 归因、600+ 模型成本估算、一键周报，Web/CLI/MCP 三模式",
  "type": "module",
  "bin": {
    "lumencode": "index.js",
    "lumencode-mcp": "src/mcp/server.js"
  },
  "scripts": {
    "start": "node index.js",
    "mcp": "node src/mcp/server.js",
    "test": "node --import ./test/_rmretry.js --test",
    "hooks:init": "node hooks/init-steps.js",
    "hooks:install": "node hooks/install.js",
    "hooks:install-claude": "node hooks/install.js",
    "hooks:install-codex": "node hooks/install-codex.js",
    "hooks:install-opencode": "node hooks/install-opencode.js",
    "hooks:install-gemini": "node hooks/install-gemini.js",
    "sync:pricing": "node scripts/sync-pricing.js"
  },
  "keywords": [
    "lumencode",
    "ai-coding",
    "ai-coding-analytics",
    "ccusage",
    "ccusage-alternative",
    "claude-code",
    "codex",
    "opencode",
    "gemini-cli",
    "copilot",
    "ai-usage",
    "token-usage",
    "ai-cost",
    "ai-attribution",
    "weekly-report",
    "usage-analytics",
    "git-insights",
    "cli",
    "visualization",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaowen51888-rich/lumencode.git"
  },
  "license": "MIT",
  "author": "zhangyaowen",
  "files": [
    "hooks/",
    "lib/",
    "src/mcp/",
    "public/",
    "data/pricing.json",
    "index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "diff-match-patch": "^1.0.5",
    "qrcode-generator": "^2.0.4",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "body-parser": "^2.2.3",
    "fast-uri": "^3.1.4",
    "hono": "^4.12.27"
  }
}
