{
  "name": "lumencode",
  "version": "1.3.3",
  "description": "LumenCode — AI 编码助手使用报告工具，从 JSONL 日志和 Git 仓库提取 AI 贡献度、效率与使用指标，支持 Web 可视化和命令行两种模式",
  "type": "module",
  "bin": {
    "lumencode": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test test",
    "hooks:init": "node hooks/init-steps.js",
    "hooks:install": "node hooks/install.js",
    "hooks:install-claude": "node hooks/install.js",
    "hooks:install-codex": "node hooks/install-codex.js"
  },
  "keywords": [
    "lumencode",
    "ai-coding",
    "usage-analytics",
    "claude-code",
    "codex",
    "opencode",
    "git-insights",
    "weekly-report",
    "cli",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaowen51888-rich/lumencode.git"
  },
  "license": "MIT",
  "author": "zhangyaowen",
  "files": [
    "hooks/",
    "lib/",
    "public/",
    "data/pricing.json",
    "index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "sql.js": "^1.14.1"
  }
}
